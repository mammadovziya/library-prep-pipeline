{
	email {$ACME_EMAIL}
	servers {
		protocols h1 h2
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip
	reverse_proxy web:3000
}

{$AUTH_DOMAIN} {
	import security_headers
	reverse_proxy authentik-server:9000
}

{$OBJECTS_DOMAIN} {
	import security_headers
	request_body {
		max_size 20GB
	}
	reverse_proxy https://storage.internal:443 {
		flush_interval -1
		transport http {
			tls_server_name storage.internal
			tls_trust_pool file /etc/library-prep/pki/ca.crt
			tls_client_auth /etc/library-prep/pki/caddy.crt /etc/library-prep/pki/caddy.key
			dial_timeout 5s
			response_header_timeout 30s
		}
	}
}
